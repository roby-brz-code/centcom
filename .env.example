# Quest Mode (/quests) configuration — copy to .env.local and fill in.

# Passphrase for the /quests login gate. Leave unset to run without auth
# (open dev mode — do NOT deploy without setting this).
QUEST_PASSWORD=

# Optional: dedicated secret for signing session cookies.
# Defaults to a hash derived from QUEST_PASSWORD if unset.
QUEST_SECRET=

# Personal Linear API key (https://linear.app/settings/api).
# Unset = demo quests. Tag big issues with the "quest:main" label in Linear
# to make them Main Quests (400 XP); everything else is a Side Quest (100 XP).
LINEAR_API_KEY=
